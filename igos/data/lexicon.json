  "tells": [
    {
      "id": "not-just",
      "regex": "\\bnot (?:just|only|merely|simply) (?:a |an |about )?[^.!?,]{1,40}[,;:\\u2014-]+\\s*(?:it'?s|it is|but|this is)\\b",
      "msg": "'not just X, it's Y' framing"
    },
    {
      "id": "not-only",
      "regex": "\\bnot only\\b[^.!?]{1,60}\\bbut (?:also)?\\b",
      "msg": "'not only... but also'"
    },
    {
      "id": "triad",
      "regex": "\\b(\\w+), (\\w+),? and (\\w+)\\b[.!]",
      "msg": "rule-of-three list ending a sentence; check it is real and not rhythm"
    },
    {
      "id": "staged-reveal",
      "regex": "(?:^|[.!\\n])\\s*(?:the result|the answer|the catch|the twist|the best part|the truth|the kicker|the secret|the problem)\\?",
      "msg": "staged one-line reveal question"
    },
    {
      "id": "colon-reveal",
      "regex": "\\bhere'?s (?:the thing|what (?:happened|i learned)|why)\\s*:",
      "msg": "'here's the thing:' setup"
    },
    {
      "id": "emoji-bullets",
      "regex": "(?:^|\\n)\\s*(?:[\\u2705\\u274c\\u27a1\\u2b50\\u2728\\U0001F449\\U0001F4A1\\U0001F680\\U0001F525\\U0001F4CC\\U0001F539\\U0001F538])\\s*\\S",
      "msg": "emoji used as bullet points"
    },
    {
      "id": "shouting",
      "regex": "\\b[A-Z]{3,}\\s+[A-Z]{3,}\\s+[A-Z]{3,}\\b",
      "msg": "a run of all-caps words"
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+\\s*){6,}",
      "msg": "hashtag wall (and over the 5-tag cap)"
    },
    {
      "id": "imagine",
      "regex": "(?:^|\\n)\\s*imagine (?:this|a world|if)\\b",
      "msg": "'Imagine...' opener"
    },
    {
      "id": "question-stack",
      "regex": "\\?[^?\\n]{0,60}\\?[^?\\n]{0,60}\\?",
      "msg": "three rhetorical questions in a row"
    },
    {
      "id": "lets-be-honest",
      "regex": "\\blet'?s be (?:honest|real)\\b",
      "msg": "'let's be honest' filler"
    },
    {
      "id": "video-preamble",
      "regex": "\\b(?:in this (?:video|reel)|today i(?:'m| am) going to|i want to talk about)\\b",
      "msg": "preamble before the point"
    },
    {
      "id": "engagement-bait",
      "regex": "\\b(?:comment yes|like if|tag (?:a friend|someone)|double tap)\\b",
      "msg": "engagement bait"
    },
    {
      "id": "both-sides",
      "regex": "\\b(?:whether you'?re|whether you are) an? [^.,]{1,30} or an? [^.,]{1,30}",
      "msg": "'whether you're a X or a Y' audience hedge"
    },
    {
      "id": "greeting",
      "regex": "^\\s*(?:hey|hi|hello) (?:everyone|guys|friends|fam|y'?all)\\b",
      "msg": "greeting opener; start at the point"
    },
    {
      "id": "algorithm-talk",
      "regex": "\\b(?:the algorithm (?:loves|hates|wants|rewards)|hack the algorithm|beat the algorithm)\\b",
      "msg": "talks about 'the algorithm' instead of the viewer"
    },
    {
      "id": "fast-paced",
      "regex": "\\b(?:fast-paced|digital age|ever-evolving|ever-changing) (?:world|landscape|era)\\b",
      "msg": "scene-setting cliche"
    }
  ],
